@model ProductListVM

@if (Model.TotalPages > 1)
{
    <div class="flex items-center justify-center gap-1 mt-8">
        @if (Model.CurrentPage > 1)
        {
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="px-3 py-1.5 border border-gray-300 rounded text-sm text-gray-600 hover:bg-gray-50">
                &laquo; Prev
            </a>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            var isActive = i == Model.CurrentPage;
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@i"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="@(isActive ? "bg-blue-600 text-white border-blue-600" : "border-gray-300 text-gray-600 hover:bg-gray-50") px-3 py-1.5 border rounded text-sm">
                @i
            </a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="px-3 py-1.5 border border-gray-300 rounded text-sm text-gray-600 hover:bg-gray-50">
                Next &raquo;
            </a>
        }
    </div>
}
