@model ProductListVM

@if (Model.TotalPages > 1)
{
    <div class="flex items-center justify-center gap-2 mt-10">
        @if (Model.CurrentPage > 1)
        {
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@(Model.CurrentPage - 1)"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="glass px-4 py-2 rounded-xl text-gray-600 hover:text-primary font-medium transition-colors">
                ← Prev
            </a>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            var isActive = i == Model.CurrentPage;
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@i"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="@(isActive ? "gradient-primary text-white" : "glass text-gray-600 hover:text-primary") px-4 py-2 rounded-xl font-medium transition-all">
                @i
            </a>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a asp-controller="Catalog" asp-action="Index"
               asp-route-page="@(Model.CurrentPage + 1)"
               asp-route-categoryId="@Model.SelectedCategoryId"
               asp-route-q="@Model.SearchQuery"
               asp-route-sort="@Model.SortBy"
               class="glass px-4 py-2 rounded-xl text-gray-600 hover:text-primary font-medium transition-colors">
                Next →
            </a>
        }
    </div>
}
