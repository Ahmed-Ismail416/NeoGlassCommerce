@model ProductListVM

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-controller="Catalog" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-sort="@Model.SortBy">&laquo;</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-controller="Catalog" asp-action="Index"
                       asp-route-page="@i"
                       asp-route-categoryId="@Model.SelectedCategoryId"
                       asp-route-q="@Model.SearchQuery"
                       asp-route-sort="@Model.SortBy">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-controller="Catalog" asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-categoryId="@Model.SelectedCategoryId"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-sort="@Model.SortBy">&raquo;</a>
            </li>
        </ul>
    </nav>
}
