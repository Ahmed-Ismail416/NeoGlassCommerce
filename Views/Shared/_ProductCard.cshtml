@model ProductCardVM

<div class="col">
    <div class="card h-100">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="card-img-top"
             style="height:200px;object-fit:cover;"
             onerror="this.src='https://placehold.co/400x200/e2e8f0/64748b?text=No+Image'" />
        <div class="card-body d-flex flex-column">
            <small class="text-muted">@Model.CategoryName</small>
            <h6 class="card-title mb-1">@Model.Name</h6>
            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="fw-bold">$@Model.Price.ToString("N2")</span>
                @if (Model.StockQuantity > 0)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary btn-sm">Add</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-danger">Out of Stock</span>
                }
            </div>
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-sm mt-2">View Details</a>
        </div>
    </div>
</div>
