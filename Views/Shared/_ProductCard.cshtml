@model ProductCardVM

<div class="bg-white border border-gray-200 rounded overflow-hidden">
    <div class="relative">
        <img src="@Model.ImageUrl" alt="@Model.Name"
             class="w-full h-48 object-cover"
             onerror="this.src='https://placehold.co/400x300/e2e8f0/64748b?text=No+Image'" />
        <div class="absolute top-2 right-2">
            @if (Model.StockQuantity > 0)
            {
                <span class="bg-green-600 text-white text-xs px-2 py-0.5 rounded">In Stock</span>
            }
            else
            {
                <span class="bg-red-600 text-white text-xs px-2 py-0.5 rounded">Out of Stock</span>
            }
        </div>
        <div class="absolute top-2 left-2">
            <span class="bg-white text-gray-700 text-xs px-2 py-0.5 rounded border border-gray-200">@Model.CategoryName</span>
        </div>
    </div>
    <div class="p-4">
        <h3 class="font-semibold text-gray-800 mb-1 truncate">@Model.Name</h3>
        <div class="flex items-center justify-between mt-2">
            <span class="text-xl font-bold text-gray-900">$@Model.Price.ToString("N2")</span>
            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700">
                        Add
                    </button>
                </form>
            }
        </div>
        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="block mt-2 text-sm text-blue-600 hover:underline">View Details</a>
    </div>
</div>
