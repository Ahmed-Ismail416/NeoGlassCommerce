<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeoGlass Commerce</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#2563EB' },
                        accent: '#16A34A',
                        danger: '#DC2626',
                        surface: '#F9FAFB'
                    }
                }
            }
        }
    </script>
    <style>
        .glass { background: #ffffff; border: 1px solid #e5e7eb; }
        .glass-dark { background: #f3f4f6; border: 1px solid #e5e7eb; }
        .gradient-primary { background-color: #2563EB; }
        .gradient-text { color: #1e3a8a; }
        .hover-lift { }
        .hover-lift:hover { }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- Navbar -->
    @await Html.PartialAsync("_Navbar")

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-3 bg-green-50 border border-green-300 text-green-800 rounded" x-data="{ show: true }" x-show="show">
                <span>@TempData["SuccessMessage"]</span>
                <button class="ml-2 font-bold" @@click="show = false">&times;</button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-10 border-t border-gray-200 bg-white">
        <div class="max-w-7xl mx-auto px-4 py-6 text-center text-gray-500 text-sm">
            <p class="font-semibold text-gray-700 mb-1">NeoGlass Commerce</p>
            <p>&copy; 2026 NeoGlass Commerce. All rights reserved.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
