@inject NeoGlassCommerce.Services.CartService CartService

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
}

<nav class="bg-white border-b border-gray-200 sticky top-0 z-50" x-data="{ mobileOpen: false }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">
            <!-- Logo -->
            <a asp-controller="Catalog" asp-action="Index" class="font-bold text-gray-800 text-lg">
                NeoGlass
            </a>

            <!-- Desktop Nav -->
            <div class="hidden md:flex items-center gap-4">
                <a asp-controller="Catalog" asp-action="Index"
                   class="@(currentController == "Catalog" ? "text-blue-600 font-semibold" : "text-gray-600 hover:text-gray-900") text-sm">
                    Products
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Orders" asp-action="Index"
                       class="@(currentController == "Orders" ? "text-blue-600 font-semibold" : "text-gray-600 hover:text-gray-900") text-sm">
                        My Orders
                    </a>
                }

                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="@(currentArea == "Admin" ? "text-blue-600 font-semibold" : "text-gray-600 hover:text-gray-900") text-sm">
                        Admin
                    </a>
                }
            </div>

            <!-- Right -->
            <div class="flex items-center gap-3">
                <!-- Search -->
                <form asp-controller="Catalog" asp-action="Index" method="get" class="hidden md:flex items-center">
                    <input type="text" name="q" placeholder="Search..." class="px-3 py-1.5 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400 w-40" />
                </form>

                <!-- Cart -->
                <a asp-controller="Cart" asp-action="Index" class="relative text-gray-700 hover:text-gray-900 text-sm">
                    Cart
                    @{
                        var cartCount = CartService.GetCartItemCount();
                    }
                    @if (cartCount > 0)
                    {
                        <span class="ml-1 bg-red-600 text-white text-xs rounded-full px-1.5 py-0.5">@cartCount</span>
                    }
                </a>

                <!-- User -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="relative" x-data="{ open: false }">
                        <button @@click="open = !open" class="text-sm text-gray-700 hover:text-gray-900 border border-gray-300 rounded px-2 py-1">
                            @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U") ▾
                        </button>
                        <div x-show="open" @@click.away="open = false" x-transition class="absolute right-0 mt-1 w-44 bg-white border border-gray-200 rounded shadow-md py-1 z-50">
                            <span class="block px-3 py-2 text-xs text-gray-500 border-b border-gray-100">@User.Identity?.Name</span>
                            <a asp-controller="Orders" asp-action="Index" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">My Orders</a>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-gray-50">Sign Out</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="bg-blue-600 text-white px-3 py-1.5 rounded text-sm hover:bg-blue-700">Sign In</a>
                }

                <!-- Mobile Toggle -->
                <button @@click="mobileOpen = !mobileOpen" class="md:hidden text-gray-700 border border-gray-300 rounded px-2 py-1 text-sm">
                    Menu
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div x-show="mobileOpen" x-transition class="md:hidden pb-3 border-t border-gray-100 mt-1 pt-3 space-y-1">
            <a asp-controller="Catalog" asp-action="Index"
               class="@(currentController == "Catalog" ? "text-blue-600 font-semibold" : "text-gray-700") block px-2 py-2 text-sm">
                Products
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Orders" asp-action="Index"
                   class="@(currentController == "Orders" ? "text-blue-600 font-semibold" : "text-gray-700") block px-2 py-2 text-sm">
                    My Orders
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="@(currentArea == "Admin" ? "text-blue-600 font-semibold" : "text-gray-700") block px-2 py-2 text-sm">
                    Admin Panel
                </a>
            }
            <form asp-controller="Catalog" asp-action="Index" method="get" class="px-2 pt-1">
                <input type="text" name="q" placeholder="Search..." class="w-full px-3 py-1.5 border border-gray-300 rounded text-sm" />
            </form>
        </div>
    </div>
</nav>
