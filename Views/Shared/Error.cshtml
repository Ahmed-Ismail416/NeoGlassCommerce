@{
    ViewData["Title"] = "Error";
}

<div class="max-w-lg mx-auto text-center py-20">
    <div class="glass rounded-3xl p-12">
        <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-800 mb-2">Oops! Something went wrong</h1>
        <p class="text-gray-500 mb-6">An error occurred while processing your request.</p>
        <a asp-controller="Catalog" asp-action="Index" class="inline-block gradient-primary text-white px-8 py-3 rounded-xl font-semibold hover:shadow-lg transition-shadow">Go Home</a>
    </div>
</div>
