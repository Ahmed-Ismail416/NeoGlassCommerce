@model LoginVM
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="min-h-[70vh] flex items-center justify-center">
    <div class="glass rounded-3xl p-10 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="w-16 h-16 gradient-primary rounded-2xl flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-800">Welcome Back</h1>
            <p class="text-gray-500 mt-1">Sign in to your account</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="All" class="text-danger text-sm mb-4"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Email" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger text-xs"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Password" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger text-xs"></span>
                </div>
                <div class="flex items-center gap-2">
                    <input asp-for="RememberMe" class="rounded border-gray-300" />
                    <label asp-for="RememberMe" class="text-sm text-gray-600">Remember me</label>
                </div>
            </div>

            <button type="submit" class="w-full gradient-primary text-white py-3.5 rounded-xl font-semibold mt-6 hover:shadow-lg hover:shadow-primary/25 transition-all">Sign In</button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register" class="text-primary font-semibold hover:underline">Create one</a>
        </p>
    </div>
</div>
