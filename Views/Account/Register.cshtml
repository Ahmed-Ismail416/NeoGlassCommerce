@model RegisterVM
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="max-w-sm mx-auto mt-10">
    <div class="bg-white border border-gray-200 rounded p-8">
        <h1 class="text-xl font-bold text-gray-800 mb-1">Create Account</h1>
        <p class="text-sm text-gray-500 mb-5">Fill in the form to get started.</p>

        <form asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-red-600 text-sm mb-3"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="FullName" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="FullName" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="John Doe" />
                    <span asp-validation-for="FullName" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Email" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Password" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs"></span>
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-2.5 rounded font-medium mt-5 hover:bg-blue-700">Create Account</button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-4">
            Already have an account?
            <a asp-controller="Account" asp-action="Login" class="text-blue-600 hover:underline">Sign in</a>
        </p>
    </div>
</div>
