@model List<OrderListItemVM>
@{
    ViewData["Title"] = "My Orders";
}

<h4 class="mb-4">My Orders</h4>

@if (Model.Any())
{
    <table class="table">
        <thead class="table-light">
            <tr>
                <th>Order</th>
                <th>Date</th>
                <th class="text-center">Items</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var badgeClass = order.Status switch
                {
                    OrderStatus.Pending => "bg-warning text-dark",
                    OrderStatus.Processing => "bg-info text-dark",
                    OrderStatus.Shipped => "bg-primary",
                    OrderStatus.Delivered => "bg-success",
                    OrderStatus.Cancelled => "bg-danger",
                    _ => "bg-secondary"
                };
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                    <td class="text-center">@order.ItemCount</td>
                    <td>$@order.TotalAmount.ToString("N2")</td>
                    <td><span class="badge @badgeClass">@order.Status</span></td>
                    <td>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">No orders yet.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Browse Products</a>
    </div>
}
