@model OrderDetailsVM
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<a asp-controller="Orders" asp-action="Index" class="btn btn-link ps-0 mb-3">&larr; Back to Orders</a>

@{
    var bc = Model.Status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Processing => "bg-info text-dark",
        OrderStatus.Shipped => "bg-primary",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-start">
        <div>
            <h5 class="mb-0">@Model.OrderNumber</h5>
            <small class="text-muted">@Model.OrderDate.ToString("MMMM dd, yyyy")</small>
        </div>
        <div class="text-end">
            <span class="badge @bc">@Model.Status</span>
            <div class="fw-bold mt-1">$@Model.TotalAmount.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">Order Items</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td style="width:56px;">
                                    <img src="@item.ImageUrl" style="width:44px;height:44px;object-fit:cover;"
                                         onerror="this.src='https://placehold.co/44/e2e8f0/64748b?text=N'" />
                                </td>
                                <td>
                                    <div>@item.ProductName</div>
                                    <small class="text-muted">$@item.UnitPrice.ToString("N2") &times; @item.Quantity</small>
                                </td>
                                <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">Shipping Address</div>
            <div class="card-body small">
                <p class="mb-1">@Model.ShippingStreet</p>
                <p class="mb-1">@Model.ShippingCity, @Model.ShippingZip</p>
                <p class="mb-0">@Model.ShippingCountry</p>
            </div>
        </div>
    </div>
</div>
