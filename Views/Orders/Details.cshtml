@model OrderDetailsVM
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<div class="max-w-3xl mx-auto">
    <a asp-controller="Orders" asp-action="Index" class="text-sm text-blue-600 hover:underline">&larr; Back to Orders</a>

    <!-- Order Header -->
    <div class="bg-white border border-gray-200 rounded p-4 mt-4 mb-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
                <h1 class="text-xl font-bold text-gray-800">@Model.OrderNumber</h1>
                <p class="text-sm text-gray-500 mt-0.5">@Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <div class="text-right">
                @{
                    var statusColor = Model.Status switch
                    {
                        OrderStatus.Pending => "bg-yellow-100 text-yellow-800",
                        OrderStatus.Processing => "bg-blue-100 text-blue-800",
                        OrderStatus.Shipped => "bg-purple-100 text-purple-800",
                        OrderStatus.Delivered => "bg-green-100 text-green-800",
                        OrderStatus.Cancelled => "bg-red-100 text-red-800",
                        _ => "bg-gray-100 text-gray-700"
                    };
                }
                <span class="inline-block text-xs px-2 py-0.5 rounded @statusColor">@Model.Status</span>
                <p class="text-xl font-bold text-gray-900 mt-1">$@Model.TotalAmount.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-4">
        <!-- Items -->
        <div class="lg:col-span-2">
            <div class="bg-white border border-gray-200 rounded p-4">
                <h2 class="font-semibold text-gray-800 mb-3">Order Items</h2>
                <div class="space-y-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="flex items-center gap-3">
                            <img src="@item.ImageUrl" class="w-12 h-12 object-cover rounded" onerror="this.src='https://placehold.co/48/e2e8f0/64748b?text=N'" />
                            <div class="flex-1">
                                <p class="font-medium text-gray-800 text-sm">@item.ProductName</p>
                                <p class="text-xs text-gray-500">$@item.UnitPrice.ToString("N2") &times; @item.Quantity</p>
                            </div>
                            <span class="font-semibold text-sm">$@item.LineTotal.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Shipping -->
        <div>
            <div class="bg-white border border-gray-200 rounded p-4">
                <h2 class="font-semibold text-gray-800 mb-2">Shipping Address</h2>
                <div class="text-sm text-gray-600 space-y-0.5">
                    <p>@Model.ShippingStreet</p>
                    <p>@Model.ShippingCity, @Model.ShippingZip</p>
                    <p>@Model.ShippingCountry</p>
                </div>
            </div>
        </div>
    </div>
</div>
