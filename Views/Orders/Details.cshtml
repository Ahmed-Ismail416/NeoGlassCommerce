@model OrderDetailsVM
@{
    ViewData["Title"] = $"Order {Model.OrderNumber}";
}

<div class="max-w-4xl mx-auto">
    <a asp-controller="Orders" asp-action="Index" class="inline-flex items-center gap-2 text-gray-500 hover:text-primary mb-6 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        Back to Orders
    </a>

    <!-- Order Header -->
    <div class="glass rounded-2xl p-8 mb-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">@Model.OrderNumber</h1>
                <p class="text-gray-500 mt-1">@Model.OrderDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
            </div>
            <div class="text-right">
                @{
                    var statusColor = Model.Status switch
                    {
                        OrderStatus.Pending => "bg-yellow-100 text-yellow-700",
                        OrderStatus.Processing => "bg-blue-100 text-blue-700",
                        OrderStatus.Shipped => "bg-purple-100 text-purple-700",
                        OrderStatus.Delivered => "bg-green-100 text-green-700",
                        OrderStatus.Cancelled => "bg-red-100 text-red-700",
                        _ => "bg-gray-100 text-gray-700"
                    };
                }
                <span class="inline-block text-sm font-semibold px-4 py-2 rounded-full @statusColor">@Model.Status</span>
                <p class="text-3xl font-bold gradient-text mt-2">$@Model.TotalAmount.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
        <!-- Items -->
        <div class="lg:col-span-2">
            <div class="glass rounded-2xl p-6">
                <h2 class="text-lg font-bold text-gray-800 mb-4">Order Items</h2>
                <div class="space-y-4">
                    @foreach (var item in Model.Items)
                    {
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-white/50">
                            <img src="@item.ImageUrl" class="w-16 h-16 object-cover rounded-xl" onerror="this.src='https://placehold.co/64/e2e8f0/64748b?text=N'" />
                            <div class="flex-1">
                                <h4 class="font-semibold text-gray-800">@item.ProductName</h4>
                                <p class="text-sm text-gray-500">$@item.UnitPrice.ToString("N2") × @item.Quantity</p>
                            </div>
                            <span class="font-bold text-gray-800">$@item.LineTotal.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Shipping -->
        <div>
            <div class="glass rounded-2xl p-6">
                <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                    Shipping Address
                </h2>
                <div class="text-sm text-gray-600 space-y-1">
                    <p>@Model.ShippingStreet</p>
                    <p>@Model.ShippingCity, @Model.ShippingZip</p>
                    <p>@Model.ShippingCountry</p>
                </div>
            </div>
        </div>
    </div>
</div>
