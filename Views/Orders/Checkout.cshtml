@model CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

<h4 class="mb-4">Checkout</h4>

<form asp-controller="Orders" asp-action="Checkout" method="post">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">Shipping Address</div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" placeholder="United States" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="New York" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col">
                            <label asp-for="Zip" class="form-label"></label>
                            <input asp-for="Zip" class="form-control" placeholder="10001" />
                            <span asp-validation-for="Zip" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Street" class="form-label"></label>
                        <input asp-for="Street" class="form-control" placeholder="123 Main Street" />
                        <span asp-validation-for="Street" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-header">Order Summary</div>
                <div class="card-body p-0" style="max-height:260px;overflow-y:auto;">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var item in Model.Cart.Items)
                            {
                                <tr>
                                    <td>@item.ProductName <small class="text-muted">&times;@item.Quantity</small></td>
                                    <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer small">
                    <div class="d-flex justify-content-between">
                        <span>Shipping</span><span class="text-success">Free</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold mt-1">
                        <span>Total</span><span>$@Model.Cart.Total.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Confirm Order</button>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-link w-100 mt-1">Back to Cart</a>
        </div>
    </div>
</form>
