@model CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

<div class="max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Checkout</h1>

    <form asp-controller="Orders" asp-action="Checkout" method="post">
        <div class="grid lg:grid-cols-5 gap-6">
            <!-- Shipping Form -->
            <div class="lg:col-span-3">
                <div class="bg-white border border-gray-200 rounded p-6">
                    <h2 class="font-semibold text-gray-800 mb-4">Shipping Address</h2>

                    <div asp-validation-summary="All" class="text-red-600 text-sm mb-3"></div>

                    <div class="space-y-4">
                        <div>
                            <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="Country" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="United States" />
                            <span asp-validation-for="Country" class="text-red-600 text-xs"></span>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label asp-for="City" class="block text-sm font-medium text-gray-700 mb-1"></label>
                                <input asp-for="City" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="New York" />
                                <span asp-validation-for="City" class="text-red-600 text-xs"></span>
                            </div>
                            <div>
                                <label asp-for="Zip" class="block text-sm font-medium text-gray-700 mb-1"></label>
                                <input asp-for="Zip" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="10001" />
                                <span asp-validation-for="Zip" class="text-red-600 text-xs"></span>
                            </div>
                        </div>
                        <div>
                            <label asp-for="Street" class="block text-sm font-medium text-gray-700 mb-1"></label>
                            <input asp-for="Street" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" placeholder="123 Main Street" />
                            <span asp-validation-for="Street" class="text-red-600 text-xs"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="lg:col-span-2 space-y-3">
                <div class="bg-white border border-gray-200 rounded p-4">
                    <h3 class="font-semibold text-gray-800 mb-3">Order Summary</h3>
                    <div class="space-y-2 max-h-56 overflow-y-auto">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <img src="@item.ImageUrl" class="w-10 h-10 object-cover rounded" onerror="this.src='https://placehold.co/40/e2e8f0/64748b?text=N'" />
                                <div class="flex-1">
                                    <p class="font-medium text-gray-800 truncate">@item.ProductName</p>
                                    <p class="text-gray-500 text-xs">x@item.Quantity</p>
                                </div>
                                <span class="text-sm font-medium">$@item.LineTotal.ToString("N2")</span>
                            </div>
                        }
                    </div>
                    <hr class="my-3 border-gray-200" />
                    <div class="flex justify-between text-gray-600 text-sm">
                        <span>Subtotal</span>
                        <span>$@Model.Cart.Total.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between text-gray-600 text-sm mt-1">
                        <span>Shipping</span>
                        <span class="text-green-700">Free</span>
                    </div>
                    <hr class="my-3 border-gray-200" />
                    <div class="flex justify-between font-bold">
                        <span>Total</span>
                        <span>$@Model.Cart.Total.ToString("N2")</span>
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded font-medium hover:bg-blue-700">
                    Confirm Order
                </button>
                <a asp-controller="Cart" asp-action="Index" class="block w-full text-center py-2 text-sm text-gray-600 hover:underline">&larr; Back to Cart</a>
            </div>
        </div>
    </form>
</div>
