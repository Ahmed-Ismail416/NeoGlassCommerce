@model ProductListVM
@{
    ViewData["Title"] = "Products";
}

<div class="flex flex-col lg:flex-row gap-6">
    <!-- Sidebar -->
    <aside class="lg:w-56 flex-shrink-0">
        <div class="bg-white border border-gray-200 rounded p-4 sticky top-20">
            <h2 class="font-semibold text-gray-800 mb-3 text-sm uppercase tracking-wide">Categories</h2>
            <div class="space-y-0.5">
                <a asp-controller="Catalog" asp-action="Index"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-sort="@Model.SortBy"
                   class="@(Model.SelectedCategoryId == null ? "bg-blue-600 text-white" : "text-gray-600 hover:bg-gray-100") block px-3 py-2 rounded text-sm">
                    All Products
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="Catalog" asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       asp-route-q="@Model.SearchQuery"
                       asp-route-sort="@Model.SortBy"
                       class="@(Model.SelectedCategoryId == cat.Id ? "bg-blue-600 text-white" : "text-gray-600 hover:bg-gray-100") flex items-center justify-between px-3 py-2 rounded text-sm">
                        <span>@cat.Name</span>
                        <span class="text-xs bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded">@cat.ProductCount</span>
                    </a>
                }
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span>Results for "@Model.SearchQuery"</span>
                    }
                    else
                    {
                        <span>Products</span>
                    }
                </h1>
                <p class="text-gray-500 text-sm mt-0.5">@Model.TotalItems products found</p>
            </div>

            <!-- Sort -->
            <div x-data="{ open: false }" class="relative">
                <button @@click="open = !open" class="border border-gray-300 bg-white px-3 py-1.5 rounded text-sm text-gray-700 hover:bg-gray-50">
                    Sort By ▾
                </button>
                <div x-show="open" @@click.away="open = false" x-transition class="absolute right-0 mt-1 w-44 bg-white border border-gray-200 rounded shadow-md py-1 z-20">
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="newest" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Newest First</a>
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="price_asc" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Price: Low to High</a>
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="price_desc" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Price: High to Low</a>
                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="name" class="block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50">Name A-Z</a>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        @if (Model.Products.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var product in Model.Products)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
        else
        {
            <div class="bg-white border border-gray-200 rounded p-10 text-center">
                <p class="text-gray-500">No products found.</p>
                <a asp-controller="Catalog" asp-action="Index" class="inline-block mt-3 bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">Browse All</a>
            </div>
        }

        <!-- Pagination -->
        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
