@model ProductListVM
@{
    ViewData["Title"] = "Products";
}

<div class="row g-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header small fw-bold">Categories</div>
            <div class="list-group list-group-flush">
                <a asp-controller="Catalog" asp-action="Index"
                   asp-route-q="@Model.SearchQuery"
                   asp-route-sort="@Model.SortBy"
                   class="list-group-item list-group-item-action @(Model.SelectedCategoryId == null ? "active" : "")">
                    All Products
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="Catalog" asp-action="Index"
                       asp-route-categoryId="@cat.Id"
                       asp-route-q="@Model.SearchQuery"
                       asp-route-sort="@Model.SortBy"
                       class="list-group-item list-group-item-action d-flex justify-content-between @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                        <span>@cat.Name</span>
                        <span class="badge bg-secondary">@cat.ProductCount</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-0">
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span>Results for "@Model.SearchQuery"</span>
                    }
                    else
                    {
                        <span>Products</span>
                    }
                </h5>
                <small class="text-muted">@Model.TotalItems items</small>
            </div>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown">Sort</button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="newest">Newest</a></li>
                    <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="price_asc">Price: Low to High</a></li>
                    <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="price_desc">Price: High to Low</a></li>
                    <li><a class="dropdown-item" asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-q="@Model.SearchQuery" asp-route-sort="name">Name A-Z</a></li>
                </ul>
            </div>
        </div>

        @if (Model.Products.Any())
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                @foreach (var product in Model.Products)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">No products found.</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-sm">Browse All</a>
            </div>
        }

        @await Html.PartialAsync("_Pagination", Model)
    </div>
</div>
