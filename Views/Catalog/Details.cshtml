@model ProductDetailsVM
@{
    ViewData["Title"] = Model.Name;
}

<div class="max-w-5xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8">
        <a asp-controller="Catalog" asp-action="Index" class="hover:text-primary transition-colors">Products</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-gray-800 font-medium">@Model.Name</span>
    </nav>

    <div class="glass rounded-3xl overflow-hidden">
        <div class="grid md:grid-cols-2 gap-0">
            <!-- Image -->
            <div class="relative bg-gradient-to-br from-primary/5 to-primary-light/5 p-8 flex items-center justify-center">
                <img src="@Model.ImageUrl" alt="@Model.Name"
                     class="max-h-96 object-contain rounded-2xl"
                     onerror="this.src='https://placehold.co/600x400/e2e8f0/64748b?text=No+Image'" />
                <div class="absolute top-6 left-6">
                    <span class="bg-white/80 text-primary text-sm font-medium px-3 py-1.5 rounded-full backdrop-blur-sm">@Model.CategoryName</span>
                </div>
            </div>

            <!-- Info -->
            <div class="p-8 lg:p-12 flex flex-col justify-center">
                <div class="space-y-6">
                    <div>
                        <p class="text-sm text-gray-400 font-medium mb-1">SKU: @Model.SKU</p>
                        <h1 class="text-3xl font-bold text-gray-800">@Model.Name</h1>
                    </div>

                    <div class="flex items-baseline gap-3">
                        <span class="text-4xl font-bold gradient-text">$@Model.Price.ToString("N2")</span>
                    </div>

                    <p class="text-gray-600 leading-relaxed">@Model.Description</p>

                    <!-- Stock -->
                    <div class="flex items-center gap-3">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="flex items-center gap-1.5 text-accent font-medium">
                                <span class="w-2.5 h-2.5 bg-accent rounded-full animate-pulse"></span>
                                In Stock (@Model.StockQuantity available)
                            </span>
                        }
                        else
                        {
                            <span class="flex items-center gap-1.5 text-danger font-medium">
                                <span class="w-2.5 h-2.5 bg-danger rounded-full"></span>
                                Out of Stock
                            </span>
                        }
                    </div>

                    <!-- Add to cart -->
                    @if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex items-center gap-4" x-data="{ qty: 1 }">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="glass rounded-xl flex items-center">
                                <button type="button" @@click="qty = Math.max(1, qty - 1)" class="px-4 py-3 text-gray-500 hover:text-primary font-bold transition-colors">−</button>
                                <input type="number" name="quantity" x-model="qty" min="1" max="@Model.StockQuantity" class="w-16 text-center bg-transparent border-0 font-semibold text-gray-800 focus:outline-none" />
                                <button type="button" @@click="qty = Math.min(@Model.StockQuantity, qty + 1)" class="px-4 py-3 text-gray-500 hover:text-primary font-bold transition-colors">+</button>
                            </div>
                            <button type="submit" class="flex-1 gradient-primary text-white py-3.5 rounded-xl font-semibold hover:shadow-lg hover:shadow-primary/25 transition-all flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
                                </svg>
                                Add to Cart
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
