@model ProductDetailsVM
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<div class="card">
    <div class="row g-0">
        <div class="col-md-5 text-center p-3 bg-light">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-height:320px;object-fit:contain;"
                 onerror="this.src='https://placehold.co/600x400/e2e8f0/64748b?text=No+Image'" />
        </div>
        <div class="col-md-7">
            <div class="card-body">
                <small class="text-muted">SKU: @Model.SKU &middot; @Model.CategoryName</small>
                <h4 class="card-title mt-1">@Model.Name</h4>
                <h5 class="mb-3">$@Model.Price.ToString("N2")</h5>
                <p class="card-text text-muted">@Model.Description</p>

                @if (Model.StockQuantity > 0)
                {
                    <p class="text-success small">In Stock (@Model.StockQuantity available)</p>
                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-2 mt-3">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity"
                               class="form-control form-control-sm" style="width:70px;" />
                        <button type="submit" class="btn btn-primary btn-sm">Add to Cart</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-danger">Out of Stock</span>
                }
            </div>
        </div>
    </div>
</div>
