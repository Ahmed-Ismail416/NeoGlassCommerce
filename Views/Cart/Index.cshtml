@model CartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Shopping Cart</h1>

    @if (Model.Items.Any())
    {
        <div class="grid lg:grid-cols-3 gap-6">
            <!-- Cart Items -->
            <div class="lg:col-span-2 space-y-3">
                @foreach (var item in Model.Items)
                {
                    <div class="bg-white border border-gray-200 rounded p-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
                        <img src="@item.ImageUrl" alt="@item.ProductName" class="w-16 h-16 object-cover rounded"
                             onerror="this.src='https://placehold.co/80x80/e2e8f0/64748b?text=N'" />
                        <div class="flex-1">
                            <h3 class="font-medium text-gray-800">@item.ProductName</h3>
                            <p class="text-sm text-gray-500">$@item.UnitPrice.ToString("N2") each</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <form asp-controller="Cart" asp-action="Update" method="post" class="flex items-center">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <div class="border border-gray-300 rounded flex items-center">
                                    <button type="submit" name="qty" value="@(item.Quantity - 1)" class="px-2 py-1 text-gray-600 hover:bg-gray-100 text-sm">−</button>
                                    <span class="px-3 text-sm font-medium">@item.Quantity</span>
                                    <button type="submit" name="qty" value="@(item.Quantity + 1)" class="px-2 py-1 text-gray-600 hover:bg-gray-100 text-sm">+</button>
                                </div>
                            </form>
                            <span class="font-semibold text-gray-800 w-20 text-right text-sm">$@item.LineTotal.ToString("N2")</span>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="text-red-600 hover:underline text-sm">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- Summary -->
            <div class="space-y-3">
                @await Html.PartialAsync("_CartSummary", Model)
                <a asp-controller="Orders" asp-action="Checkout"
                   class="block w-full bg-blue-600 text-white text-center py-3 rounded font-medium hover:bg-blue-700">
                    Proceed to Checkout
                </a>
                <a asp-controller="Catalog" asp-action="Index"
                   class="block w-full text-center py-2 text-sm text-gray-600 hover:underline">
                    &larr; Continue Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white border border-gray-200 rounded p-10 text-center">
            <h2 class="text-lg font-semibold text-gray-800 mb-2">Your cart is empty</h2>
            <p class="text-gray-500 text-sm mb-4">You haven't added anything yet.</p>
            <a asp-controller="Catalog" asp-action="Index" class="inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 text-sm">Start Shopping</a>
        </div>
    }
</div>
