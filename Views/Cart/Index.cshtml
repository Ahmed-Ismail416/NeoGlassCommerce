@model CartVM
@{
    ViewData["Title"] = "Shopping Cart";
}

<h4 class="mb-4">Shopping Cart</h4>

@if (Model.Items.Any())
{
    <div class="row g-4">
        <div class="col-lg-8">
            <table class="table">
                <thead class="table-light">
                    <tr>
                        <th colspan="2">Product</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="width:64px;">
                                <img src="@item.ImageUrl" alt="@item.ProductName" style="width:48px;height:48px;object-fit:cover;"
                                     onerror="this.src='https://placehold.co/48/e2e8f0/64748b?text=N'" />
                            </td>
                            <td>
                                <div>@item.ProductName</div>
                                <small class="text-muted">$@item.UnitPrice.ToString("N2") each</small>
                            </td>
                            <td class="text-center">
                                <form asp-controller="Cart" asp-action="Update" method="post" class="d-inline-flex align-items-center">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" name="qty" value="@(item.Quantity - 1)" class="btn btn-outline-secondary btn-sm px-2 py-0">−</button>
                                    <span class="mx-2">@item.Quantity</span>
                                    <button type="submit" name="qty" value="@(item.Quantity + 1)" class="btn btn-outline-secondary btn-sm px-2 py-0">+</button>
                                </form>
                            </td>
                            <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                            <td>
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-4">
            @await Html.PartialAsync("_CartSummary", Model)
            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary w-100 mt-2">Proceed to Checkout</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-link w-100 mt-1">Continue Shopping</a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Your cart is empty.</p>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Start Shopping</a>
    </div>
}
