@model AdminDashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Total Products</h6>
                <h3>@Model.TotalProducts</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Total Orders</h6>
                <h3>@Model.TotalOrders</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h6 class="card-subtitle text-muted mb-1">Revenue</h6>
                <h3>$@Model.TotalRevenue.ToString("N2")</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Recent Orders</span>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentOrders.Any())
        {
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        var bc = order.Status switch
                        {
                            OrderStatus.Pending => "bg-warning text-dark",
                            OrderStatus.Processing => "bg-info text-dark",
                            OrderStatus.Shipped => "bg-primary",
                            OrderStatus.Delivered => "bg-success",
                            OrderStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge @bc">@order.Status</span></td>
                            <td class="text-end">$@order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted text-center py-4">No orders yet.</p>
        }
    </div>
</div>
