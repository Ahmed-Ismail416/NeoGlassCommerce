@model AdminDashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="glass rounded-2xl p-6 hover-lift">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">Total Products</p>
                <p class="text-3xl font-bold text-gray-800 mt-1">@Model.TotalProducts</p>
            </div>
            <div class="w-14 h-14 gradient-primary rounded-2xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            </div>
        </div>
    </div>

    <div class="glass rounded-2xl p-6 hover-lift">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">Total Orders</p>
                <p class="text-3xl font-bold text-gray-800 mt-1">@Model.TotalOrders</p>
            </div>
            <div class="w-14 h-14 bg-accent rounded-2xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
            </div>
        </div>
    </div>

    <div class="glass rounded-2xl p-6 hover-lift">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500 font-medium">Revenue</p>
                <p class="text-3xl font-bold gradient-text mt-1">$@Model.TotalRevenue.ToString("N2")</p>
            </div>
            <div class="w-14 h-14 bg-yellow-400 rounded-2xl flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="glass rounded-2xl p-6">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">Recent Orders</h2>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="text-primary hover:underline font-medium text-sm">View All →</a>
    </div>

    @if (Model.RecentOrders.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-gray-100">
                        <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Order</th>
                        <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="py-3 px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr class="hover:bg-white/50 transition-colors">
                            <td class="py-4 px-4 font-medium text-gray-800">@order.OrderNumber</td>
                            <td class="py-4 px-4 text-sm text-gray-500">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td class="py-4 px-4">
                                @{
                                    var sc = order.Status switch
                                    {
                                        OrderStatus.Pending => "bg-yellow-100 text-yellow-700",
                                        OrderStatus.Processing => "bg-blue-100 text-blue-700",
                                        OrderStatus.Shipped => "bg-purple-100 text-purple-700",
                                        OrderStatus.Delivered => "bg-green-100 text-green-700",
                                        OrderStatus.Cancelled => "bg-red-100 text-red-700",
                                        _ => "bg-gray-100 text-gray-700"
                                    };
                                }
                                <span class="text-xs font-semibold px-3 py-1 rounded-full @sc">@order.Status</span>
                            </td>
                            <td class="py-4 px-4 font-bold text-right">$@order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-gray-500 text-center py-8">No orders yet.</p>
    }
</div>
