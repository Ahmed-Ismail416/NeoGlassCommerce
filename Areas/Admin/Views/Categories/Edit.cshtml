@model AdminCategoryVM
@{
    ViewData["Title"] = "Edit Category";
}

<div class="max-w-lg">
    <div class="glass rounded-2xl p-8">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger text-sm mb-4"></div>

            <div class="space-y-5">
                <div>
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                    <span asp-validation-for="Name" class="text-danger text-xs"></span>
                </div>
                <div>
                    <label asp-for="ParentCategoryId" class="block text-sm font-medium text-gray-700 mb-1.5">Parent Category</label>
                    <select asp-for="ParentCategoryId" asp-items="ViewBag.ParentCategories" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50">
                        <option value="">None (Top Level)</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-8">
                <button type="submit" class="gradient-primary text-white px-8 py-3 rounded-xl font-semibold hover:shadow-lg transition-all">Update Category</button>
                <a asp-action="Index" class="px-6 py-3 rounded-xl text-gray-600 hover:bg-gray-100 font-medium transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
