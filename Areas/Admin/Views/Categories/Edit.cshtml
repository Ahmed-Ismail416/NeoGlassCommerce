@model AdminCategoryVM
@{
    ViewData["Title"] = "Edit Category";
}

<div class="col-lg-5">
    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ParentCategoryId" class="form-label">Parent Category</label>
                    <select asp-for="ParentCategoryId" asp-items="ViewBag.ParentCategories" class="form-select">
                        <option value="">None (Top Level)</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Update</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
