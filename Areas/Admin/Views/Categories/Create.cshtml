@model AdminCategoryVM
@{
    ViewData["Title"] = "Create Category";
}

<div class="max-w-md">
    <div class="bg-white border border-gray-200 rounded p-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-red-600 text-sm mb-3"></div>

            <div class="space-y-4">
                <div>
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" />
                    <span asp-validation-for="Name" class="text-red-600 text-xs"></span>
                </div>
                <div>
                    <label asp-for="ParentCategoryId" class="block text-sm font-medium text-gray-700 mb-1">Parent Category</label>
                    <select asp-for="ParentCategoryId" asp-items="ViewBag.ParentCategories" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400">
                        <option value="">None (Top Level)</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-6">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded font-medium hover:bg-blue-700 text-sm">Create Category</button>
                <a asp-action="Index" class="px-5 py-2 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>
