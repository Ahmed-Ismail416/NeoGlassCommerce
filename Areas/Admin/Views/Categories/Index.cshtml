@model List<AdminCategoryVM>
@{
    ViewData["Title"] = "Categories";
}

<div class="flex items-center justify-between mb-4">
    <p class="text-sm text-gray-500">@Model.Count categories total</p>
    <a asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">
        + Add Category
    </a>
</div>

<div class="bg-white border border-gray-200 rounded overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-gray-200 bg-gray-50">
                    <th class="py-3 px-4 font-medium text-gray-500">Name</th>
                    <th class="py-3 px-4 font-medium text-gray-500">Parent</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-center">Products</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="py-3 px-4 font-medium text-gray-800">@c.Name</td>
                        <td class="py-3 px-4 text-gray-500">@(c.ParentCategoryName ?? "—")</td>
                        <td class="py-3 px-4 text-center text-gray-700">@c.ProductCount</td>
                        <td class="py-3 px-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="text-blue-600 hover:underline">Edit</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this category?')">
                                    <button type="submit" class="text-red-600 hover:underline">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
