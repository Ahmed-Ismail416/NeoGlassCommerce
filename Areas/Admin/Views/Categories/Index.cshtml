@model List<AdminCategoryVM>
@{
    ViewData["Title"] = "Categories";
}

<div class="flex items-center justify-between mb-6">
    <p class="text-gray-500">@Model.Count categories total</p>
    <a asp-action="Create" class="gradient-primary text-white px-5 py-2.5 rounded-xl font-medium hover:shadow-lg hover:shadow-primary/25 transition-all flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
        Add Category
    </a>
</div>

<div class="glass rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-gray-100 bg-white/30">
                    <th class="py-4 px-5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="py-4 px-5 text-xs font-semibold text-gray-500 uppercase tracking-wider">Parent</th>
                    <th class="py-4 px-5 text-xs font-semibold text-gray-500 uppercase tracking-wider text-center">Products</th>
                    <th class="py-4 px-5 text-xs font-semibold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var c in Model)
                {
                    <tr class="hover:bg-white/50 transition-colors">
                        <td class="py-4 px-5 font-medium text-gray-800">@c.Name</td>
                        <td class="py-4 px-5 text-sm text-gray-500">@(c.ParentCategoryName ?? "—")</td>
                        <td class="py-4 px-5 text-center">
                            <span class="bg-primary/10 text-primary text-sm font-semibold px-3 py-1 rounded-full">@c.ProductCount</span>
                        </td>
                        <td class="py-4 px-5 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="p-2 rounded-lg text-primary hover:bg-primary/10 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this category?')">
                                    <button type="submit" class="p-2 rounded-lg text-danger hover:bg-red-50 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
