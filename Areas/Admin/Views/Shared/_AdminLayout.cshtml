<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { poppins: ['Poppins', 'sans-serif'] },
                    colors: {
                        primary: { DEFAULT: '#6366F1', light: '#8B5CF6' },
                        accent: '#22C55E',
                        danger: '#EF4444',
                        surface: '#F1F5F9'
                    }
                }
            }
        }
    </script>
    <style>
        * { font-family: 'Poppins', sans-serif; }
        .glass { background: rgba(255,255,255,0.7); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.3); }
        .gradient-primary { background: linear-gradient(135deg, #6366F1, #8B5CF6); }
        .gradient-text { background: linear-gradient(135deg, #6366F1, #8B5CF6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    </style>
</head>
<body class="bg-surface min-h-screen font-poppins">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside class="w-64 glass border-r border-white/20 fixed h-full z-40 hidden lg:block">
            <div class="p-6">
                <a asp-area="" asp-controller="Catalog" asp-action="Index" class="flex items-center gap-2 mb-8">
                    <div class="w-10 h-10 gradient-primary rounded-xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <div>
                        <span class="text-lg font-bold gradient-text">NeoGlass</span>
                        <span class="block text-xs text-gray-400 -mt-1">Admin Panel</span>
                    </div>
                </a>

                <nav class="space-y-1">
                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    }
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="@(controller == "Dashboard" ? "gradient-primary text-white shadow-lg shadow-primary/25" : "text-gray-600 hover:bg-primary/10 hover:text-primary") flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        Dashboard
                    </a>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                       class="@(controller == "Products" ? "gradient-primary text-white shadow-lg shadow-primary/25" : "text-gray-600 hover:bg-primary/10 hover:text-primary") flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                        Products
                    </a>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                       class="@(controller == "Categories" ? "gradient-primary text-white shadow-lg shadow-primary/25" : "text-gray-600 hover:bg-primary/10 hover:text-primary") flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                        Categories
                    </a>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       class="@(controller == "Orders" ? "gradient-primary text-white shadow-lg shadow-primary/25" : "text-gray-600 hover:bg-primary/10 hover:text-primary") flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                        Orders
                    </a>
                </nav>

                <hr class="my-6 border-gray-200" />

                <a asp-area="" asp-controller="Catalog" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-500 hover:bg-gray-100 hover:text-gray-700 font-medium transition-all text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                    Back to Store
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 lg:ml-64 p-6 lg:p-8">
            <!-- Top Bar -->
            <div class="flex items-center justify-between mb-8">
                <h1 class="text-2xl font-bold text-gray-800">@ViewData["Title"]</h1>
                <div class="flex items-center gap-3">
                    <span class="text-sm text-gray-500">@User.Identity?.Name</span>
                    <div class="w-9 h-9 gradient-primary rounded-full flex items-center justify-center">
                        <span class="text-white text-sm font-semibold">A</span>
                    </div>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 flex items-center gap-2" x-data="{ show: true }" x-show="show">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                    <span>@TempData["Success"]</span>
                    <button class="ml-auto" @@click="show = false">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 flex items-center gap-2" x-data="{ show: true }" x-show="show">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                    <span>@TempData["Error"]</span>
                    <button class="ml-auto" @@click="show = false">&times;</button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
