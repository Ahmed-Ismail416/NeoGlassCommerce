<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#2563EB' },
                        accent: '#16A34A',
                        danger: '#DC2626',
                        surface: '#F9FAFB'
                    }
                }
            }
        }
    </script>
    <style>
        .glass { background: #ffffff; border: 1px solid #e5e7eb; }
        .gradient-primary { background-color: #2563EB; }
        .gradient-text { color: #1e3a8a; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside class="w-56 bg-white border-r border-gray-200 fixed h-full z-40 hidden lg:block">
            <div class="p-4">
                <a asp-area="" asp-controller="Catalog" asp-action="Index" class="block mb-6">
                    <span class="text-lg font-bold text-gray-800">NeoGlass</span>
                    <span class="block text-xs text-gray-500">Admin Panel</span>
                </a>

                <nav class="space-y-1">
                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    }
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="@(controller == "Dashboard" ? "bg-blue-600 text-white" : "text-gray-700 hover:bg-gray-100") block px-3 py-2 rounded font-medium text-sm">
                        Dashboard
                    </a>
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                       class="@(controller == "Products" ? "bg-blue-600 text-white" : "text-gray-700 hover:bg-gray-100") block px-3 py-2 rounded font-medium text-sm">
                        Products
                    </a>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
                       class="@(controller == "Categories" ? "bg-blue-600 text-white" : "text-gray-700 hover:bg-gray-100") block px-3 py-2 rounded font-medium text-sm">
                        Categories
                    </a>
                    <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
                       class="@(controller == "Orders" ? "bg-blue-600 text-white" : "text-gray-700 hover:bg-gray-100") block px-3 py-2 rounded font-medium text-sm">
                        Orders
                    </a>
                </nav>

                <hr class="my-4 border-gray-200" />

                <a asp-area="" asp-controller="Catalog" asp-action="Index"
                   class="block px-3 py-2 rounded text-gray-500 hover:bg-gray-100 text-sm">
                    &larr; Back to Store
                </a>
            </div>
        </aside>

        <!-- Main -->
        <main class="flex-1 lg:ml-56 p-6">
            <!-- Top Bar -->
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gray-200">
                <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
                <span class="text-sm text-gray-500">@User.Identity?.Name</span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="mb-4 p-3 bg-green-50 border border-green-300 text-green-800 rounded" x-data="{ show: true }" x-show="show">
                    <span>@TempData["Success"]</span>
                    <button class="ml-2 font-bold" @@click="show = false">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-4 p-3 bg-red-50 border border-red-300 text-red-800 rounded" x-data="{ show: true }" x-show="show">
                    <span>@TempData["Error"]</span>
                    <button class="ml-2 font-bold" @@click="show = false">&times;</button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
