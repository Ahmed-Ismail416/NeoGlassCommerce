@model AdminProductVM
@{
    ViewData["Title"] = "Create Product";
}

<div class="max-w-2xl">
    <div class="glass rounded-2xl p-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger text-sm mb-4"></div>

            <div class="space-y-5">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                        <input asp-for="Name" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                        <span asp-validation-for="Name" class="text-danger text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="SKU" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                        <input asp-for="SKU" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                        <span asp-validation-for="SKU" class="text-danger text-xs"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                    <textarea asp-for="Description" rows="4" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50"></textarea>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1.5"></label>
                        <input asp-for="Price" type="number" step="0.01" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                    </div>
                    <div>
                        <label asp-for="StockQuantity" class="block text-sm font-medium text-gray-700 mb-1.5">Stock</label>
                        <input asp-for="StockQuantity" type="number" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" />
                    </div>
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 mb-1.5">Category</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50">
                            <option value="">Select...</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label asp-for="ImageUrl" class="block text-sm font-medium text-gray-700 mb-1.5">Image URL</label>
                    <input asp-for="ImageUrl" class="w-full px-4 py-3 rounded-xl bg-white/50 border border-white/30 focus:outline-none focus:ring-2 focus:ring-primary/50" placeholder="https://..." />
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsActive" class="rounded border-gray-300" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-8">
                <button type="submit" class="gradient-primary text-white px-8 py-3 rounded-xl font-semibold hover:shadow-lg transition-all">Create Product</button>
                <a asp-action="Index" class="px-6 py-3 rounded-xl text-gray-600 hover:bg-gray-100 font-medium transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
