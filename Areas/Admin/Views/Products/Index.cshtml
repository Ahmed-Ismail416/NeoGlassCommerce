@model List<AdminProductVM>
@{
    ViewData["Title"] = "Products";
}

<div class="flex items-center justify-between mb-4">
    <p class="text-sm text-gray-500">@Model.Count products total</p>
    <a asp-action="Create" class="bg-blue-600 text-white px-4 py-2 rounded text-sm hover:bg-blue-700">
        + Add Product
    </a>
</div>

<div class="bg-white border border-gray-200 rounded overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-gray-200 bg-gray-50">
                    <th class="py-3 px-4 font-medium text-gray-500">Product</th>
                    <th class="py-3 px-4 font-medium text-gray-500">SKU</th>
                    <th class="py-3 px-4 font-medium text-gray-500">Category</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-right">Price</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-center">Stock</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-center">Status</th>
                    <th class="py-3 px-4 font-medium text-gray-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-2">
                                <img src="@p.ImageUrl" class="w-9 h-9 rounded object-cover" onerror="this.src='https://placehold.co/40/e2e8f0/64748b?text=N'" />
                                <span class="font-medium text-gray-800">@p.Name</span>
                            </div>
                        </td>
                        <td class="py-3 px-4 text-gray-500">@p.SKU</td>
                        <td class="py-3 px-4 text-gray-500">@p.CategoryName</td>
                        <td class="py-3 px-4 font-medium text-right">$@p.Price.ToString("N2")</td>
                        <td class="py-3 px-4 text-center">
                            <span class="@(p.StockQuantity > 0 ? "text-green-700" : "text-red-600") font-medium">@p.StockQuantity</span>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <span class="@(p.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800") text-xs px-2 py-0.5 rounded">
                                @(p.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="py-3 px-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="text-blue-600 hover:underline">Edit</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Delete this product?')">
                                    <button type="submit" class="text-red-600 hover:underline">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
