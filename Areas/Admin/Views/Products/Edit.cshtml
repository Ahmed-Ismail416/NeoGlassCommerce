@model AdminProductVM
@{
    ViewData["Title"] = "Edit Product";
}

<div class="max-w-2xl">
    <div class="bg-white border border-gray-200 rounded p-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-red-600 text-sm mb-3"></div>

            <div class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" />
                        <span asp-validation-for="Name" class="text-red-600 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="SKU" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="SKU" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" />
                        <span asp-validation-for="SKU" class="text-red-600 text-xs"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
                    <textarea asp-for="Description" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400"></textarea>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-1"></label>
                        <input asp-for="Price" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" />
                    </div>
                    <div>
                        <label asp-for="StockQuantity" class="block text-sm font-medium text-gray-700 mb-1">Stock</label>
                        <input asp-for="StockQuantity" type="number" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400" />
                    </div>
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:outline-none focus:border-blue-400">
                            <option value="">Select...</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Product Image</label>
                    <div class="space-y-2">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div>
                                <p class="text-xs text-gray-500 mb-1">Current image:</p>
                                <img id="edit-preview" src="@Model.ImageUrl" alt="Current" class="h-24 w-24 object-cover rounded border border-gray-300" />
                            </div>
                        }
                        else
                        {
                            <img id="edit-preview" src="#" alt="Preview" class="h-24 w-24 object-cover rounded border border-gray-300 hidden" />
                        }
                        <input type="file" asp-for="ImageFile" accept="image/*"
                               class="w-full text-sm text-gray-600 border border-gray-300 rounded px-3 py-2 cursor-pointer"
                               onchange="previewEditImage(this)" />
                        <span asp-validation-for="ImageFile" class="text-red-600 text-xs"></span>
                        <input type="hidden" asp-for="ImageUrl" />
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsActive" class="rounded border-gray-300" />
                    <label asp-for="IsActive" class="text-sm font-medium text-gray-700">Active</label>
                </div>
            </div>

            <div class="flex items-center gap-3 mt-6">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded font-medium hover:bg-blue-700 text-sm">Update Product</button>
                <a asp-action="Index" class="px-5 py-2 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
function previewEditImage(input) {
    if (input.files && input.files[0]) {
        if (input.files[0].size > 5 * 1024 * 1024) {
            alert('Image must be 5 MB or smaller.');
            input.value = '';
            return;
        }
        const reader = new FileReader();
        reader.onload = e => {
            const img = document.getElementById('edit-preview');
            img.src = e.target.result;
            img.classList.remove('hidden');
        };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
